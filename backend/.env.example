# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB Atlas — paste your connection string from Atlas "Connect" > "Drivers"
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notes_app?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-this-with-a-long-random-secret-string
JWT_EXPIRES_IN=1d
